# Copie para .env e preencha. NUNCA commite o .env real.

# --- API do Claude ---------------------------------------------------------
ANTHROPIC_API_KEY=
# Opcional; padrão: claude-opus-4-8
CLAUDE_MODEL=claude-opus-4-8

# --- Google Workspace ------------------------------------------------------
# Caminho do JSON da service account de LEITURA
# (escopos: drive.readonly + spreadsheets.readonly)
GOOGLE_READER_CREDENTIALS_FILE=./credentials/reader-sa.json

# Caminho do JSON da service account de ESCRITA — separada da leitura.
# Na planilha, esta conta só pode editar a aba `Pendente` (ver README,
# seção "Restringindo a escrita à aba Pendente").
GOOGLE_WRITER_CREDENTIALS_FILE=./credentials/writer-sa.json

# ID da planilha (o trecho entre /d/ e /edit na URL do Google Sheets)
SPREADSHEET_ID=

# ===========================================================================
# OTIMIZAÇÕES DE CUSTO — cada uma se reverte mudando UMA variável aqui.
# Ver README, seção "Otimizações de custo e como revertê-las".
# ===========================================================================

# [1] Profundidade de raciocínio. O padrão da API é "high"; usamos "medium"
#     porque output custa 5x o input e inclui os tokens de thinking.
#     >>> REVERTER AO COMPORTAMENTO ORIGINAL: CLAUDE_EFFORT=high
#     Aceita: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# [2] Quantos caracteres do documento vão para a etapa de CLASSIFICAÇÃO
#     (início + fim; o miolo não ajuda a identificar o tipo e a página de
#     assinaturas está no fim). A EXTRAÇÃO sempre usa o documento completo.
#     >>> REVERTER AO COMPORTAMENTO ORIGINAL: CLASSIFY_CHAR_LIMIT=0
CLASSIFY_CHAR_LIMIT=12000

# --- Processamento em lote (opcional) --------------------------------------
# Quantas categorias de termo vão em cada chamada ao modelo.
# Maior = mais rápido e barato; menor = mais atenção do modelo por termo.
CATEGORY_BATCH_SIZE=5

# --- Checkpoint interativo (opcional) --------------------------------------
# Pergunta "continuar? [s/N]" no terminal. Dispara pelo que vier primeiro.
# Ambos podem ser sobrepostos na linha de comando com --pausar-a-cada
# e --orcamento-usd.

# Pergunta a cada N deals. 0 = desligado.
PAUSE_EVERY_DEALS=0

# Orçamento em dólares para a estimativa de gasto. 0 = sem orçamento.
# ATENÇÃO: é um teto que VOCÊ declara. A API do Claude não informa saldo
# nem limite de gasto — o número é calculado localmente a partir dos
# tokens de cada resposta.
BUDGET_USD=0

# Em que porcentagem do orçamento perguntar (avisa aqui e de novo em 100%).
BUDGET_WARN_PCT=80

# O que fazer quando não há terminal para perguntar (nohup, cron):
# "parar" (padrão, seguro — a idempotência retoma depois) ou "continuar".
CHECKPOINT_SEM_TERMINAL=parar

# Preços por milhão de tokens, usados só para a ESTIMATIVA de custo.
# Padrão: claude-opus-4-8. Ajuste se trocar de modelo.
PRICE_INPUT_PER_MTOK=5.0
PRICE_OUTPUT_PER_MTOK=25.0

# --- Colunas da aba `Deals` (opcional) -------------------------------------
# Só precisa mexer se sua planilha usar outros nomes — o código também
# tenta aliases comuns e, para a pasta, qualquer coluna com link do Drive.
DEALS_COMPANY_COLUMN=Empresa
DEALS_FOLDER_COLUMN=Pasta_Documentos_Assinados
