# Copie para .env e preencha. NUNCA commite o .env real.

# --- API do Claude ---------------------------------------------------------
ANTHROPIC_API_KEY=
# Opcional; padrão: claude-opus-4-8
CLAUDE_MODEL=claude-opus-4-8

# --- Google Workspace ------------------------------------------------------
# Caminho do JSON da service account de LEITURA
# (escopos: drive.readonly + spreadsheets.readonly)
GOOGLE_READER_CREDENTIALS_FILE=./credentials/reader-sa.json

# Caminho do JSON da service account de ESCRITA — separada da leitura.
# Na planilha, esta conta só pode editar a aba `Pendente` (ver README,
# seção "Restringindo a escrita à aba Pendente").
GOOGLE_WRITER_CREDENTIALS_FILE=./credentials/writer-sa.json

# ID da planilha (o trecho entre /d/ e /edit na URL do Google Sheets)
SPREADSHEET_ID=

# --- Processamento em lote (opcional) --------------------------------------
# Quantas categorias de termo vão em cada chamada ao modelo.
# Maior = mais rápido e barato; menor = mais atenção do modelo por termo.
# Padrão: 5
CATEGORY_BATCH_SIZE=5

# Nomes das colunas na aba `Deals`. Só precisa mexer se sua planilha usar
# outros nomes — o código também tenta aliases comuns e, para a pasta,
# qualquer coluna que contenha um link do Drive.
DEALS_COMPANY_COLUMN=Empresa
DEALS_FOLDER_COLUMN=Pasta_Documentos_Assinados
